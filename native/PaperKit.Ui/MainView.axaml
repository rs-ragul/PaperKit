<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PaperKit.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
             x:Class="PaperKit.App.MainView"
             Background="{StaticResource Canvas}">

  <Grid RowDefinitions="Auto,*">

    <!-- ============================================ top bar -->
    <Border Grid.Row="0" Classes="topbar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0" Classes="mark" VerticalAlignment="Center">
          <Path Classes="markIcon" Data="M7 3h6l5 5v13H7zM13 3v5h5M10 13h6M10 17h4" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="brand" Text="PaperKit" />
          <TextBlock Classes="tagline" Text="Every PDF tool. Nothing leaves your device." />
        </StackPanel>

        <TextBox Grid.Column="2" Classes="search" Margin="0,0,14,0" VerticalAlignment="Center"
                 Text="{Binding Search, Mode=TwoWay}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
          <Button Classes="ghost" Content="All tools"
                  Command="{Binding BackCommand}"
                  IsVisible="{Binding !IsHome}" />
          <Border Classes="badge">
            <TextBlock Classes="badge" Text="100% OFFLINE" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================ home -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,26,30,40" Spacing="4" IsVisible="{Binding IsHome}">

        <TextBlock Classes="hero" Text="Every PDF tool you need." />
        <TextBlock Classes="subtitle" Margin="0,4,0,18"
                   Text="Merge, split, organise, convert, compress, protect and verify - all on your own device." />

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ToolGroupViewModel">
              <StackPanel Margin="0,0,0,22" IsVisible="{Binding !IsEmpty}">
                <TextBlock Classes="groupTitle" Text="{Binding Title}" />
                <TextBlock Classes="groupSubtitle" Margin="0,2,0,12" Text="{Binding Subtitle}" />
                <ItemsControl ItemsSource="{Binding Tools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ToolCardViewModel">
                      <Button Classes="card"
                              Command="{Binding OpenCommand}"
                              CommandParameter="{Binding}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Top">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Grid.Column="0" Classes="cardIcon">
                            <Path Classes="cardIcon" Data="{Binding Icon}" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="12,0,8,0">
                            <TextBlock Classes="cardName" Text="{Binding Name}" />
                            <TextBlock Classes="cardBlurb" Text="{Binding Blurb}" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="soon" VerticalAlignment="Top"
                                  IsVisible="{Binding NotReady}">
                            <TextBlock Classes="soon" Text="SOON" />
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

    <!-- ============================================ tool screen -->
    <Grid Grid.Row="1" Margin="30,22,30,30" ColumnDefinitions="520,*"
          IsVisible="{Binding !IsHome}">

      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,24,0">

        <Button Grid.Row="0" Classes="ghost" HorizontalAlignment="Left" Margin="-8,0,0,4"
                Content="← All tools" Command="{Binding BackCommand}" />

        <StackPanel Grid.Row="1" Margin="0,0,0,18">
          <TextBlock Classes="hero" FontSize="27" Text="{Binding CurrentToolName}" />
          <TextBlock Classes="subtitle" Margin="0,4,0,0" Text="{Binding CurrentToolBlurb}" />
          <TextBlock Classes="notice" Margin="0,6,0,0" IsVisible="{Binding !CurrentToolReady}"
                     Text="This tool is still being built - the tools that work are the ones without the SOON badge." />
        </StackPanel>

        <!-- files -->
        <Border Grid.Row="2" Classes="panel" Margin="0,0,0,16">
          <StackPanel Spacing="12">
            <TextBlock Classes="panelTitle" Text="FILES" />
            <Border Classes="dropzone" DragDrop.AllowDrop="True">
              <StackPanel HorizontalAlignment="Center" Spacing="3">
                <TextBlock Classes="dropTitle" HorizontalAlignment="Center" Text="Drop a PDF here" />
                <TextBlock Classes="dropHint" HorizontalAlignment="Center" Text="or" />
                <Button Classes="primary" HorizontalAlignment="Center" Padding="16,9"
                        Content="Browse your files" Command="{Binding PickFilesCommand}" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:FileItem">
                  <Border Background="{StaticResource Canvas}" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Classes="fileName" Text="{Binding Name}" />
                        <TextBlock Classes="fileSize" Text="{Binding SizeText}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="Remove"
                              Command="{Binding RemoveFileCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- options -->
        <Border Grid.Row="3" Classes="panel">
          <StackPanel Spacing="14">
            <TextBlock Classes="panelTitle" Text="OPTIONS" />
            <ItemsControl ItemsSource="{Binding Options}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:OptionItem">
                  <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>
                      <DataTemplate DataType="vm:ChoiceOption">
                        <StackPanel>
                          <TextBlock Classes="optionLabel" Text="{Binding Label}" />
                          <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding Choices}"
                                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
                        </StackPanel>
                      </DataTemplate>
                      <DataTemplate DataType="vm:TextOption">
                        <StackPanel>
                          <TextBlock Classes="optionLabel" Text="{Binding Label}" />
                          <TextBox Classes="field" Text="{Binding Value, Mode=TwoWay}" />
                        </StackPanel>
                      </DataTemplate>
                      <DataTemplate DataType="vm:NumberOption">
                        <StackPanel>
                          <TextBlock Classes="optionLabel" Text="{Binding Label}" />
                          <TextBox Classes="field" Text="{Binding Value, Mode=TwoWay}" />
                        </StackPanel>
                      </DataTemplate>
                      <DataTemplate DataType="vm:ToggleOption">
                        <StackPanel>
                          <TextBlock Classes="optionLabel" Text="{Binding Label}" />
                          <CheckBox Classes="field" Content="{Binding Label}"
                                    IsChecked="{Binding IsOn, Mode=TwoWay}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="notice" Text="Everything is processed on this device." />
          </StackPanel>
        </Border>
      </Grid>

      <!-- result -->
      <Border Grid.Column="1" Classes="panel" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <TextBlock Classes="panelTitle" Text="RESULT" />
          <Button Classes="primary" Content="Run" Command="{Binding RunCommand}"
                  IsEnabled="{Binding CanRun}" />

          <TextBlock Classes="notice" Text="{Binding Status}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ResultItem">
                <Border Background="{StaticResource Canvas}" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                      <TextBlock Classes="resultName" Text="{Binding Name}" />
                      <TextBlock Classes="fileSize" Text="{Binding SizeText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" Padding="14,7" Content="Save"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </Grid>

  </Grid>
</UserControl>
