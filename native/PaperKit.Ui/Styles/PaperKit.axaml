<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <Color x:Key="Accent">#4F46E5</Color>
    <Color x:Key="AccentSoft">#EEF0FE</Color>
    <Color x:Key="Canvas">#F6F7FB</Color>
    <Color x:Key="Line">#E3E7EE</Color>
    <Color x:Key="Ink">#111827</Color>
    <Color x:Key="Muted">#6B7280</Color>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Canvas}" />
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- top bar -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="28,14" />
  </Style>

  <Style Selector="Border.mark">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>

  <Style Selector="Path.markIcon">
    <Setter Property="Stroke" Value="#FFFFFF" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>

  <Style Selector="TextBlock.tagline">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="Width" Value="280" />
    <Setter Property="Height" Value="38" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Canvas}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Watermark" Value="Search tools" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#ECFDF5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.soon">
    <Setter Property="Background" Value="#F1F2F6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="TextBlock.soon">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#6B7280" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>

  <Style Selector="TextBlock.badge">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#047857" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>

  <!-- headings -->
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>

  <Style Selector="TextBlock.groupSubtitle">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <!-- cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,14,14" />
    <Setter Property="Width" Value="252" />
  </Style>

  <Style Selector="Border.card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FBFBFE" />
    <Setter Property="BorderBrush" Value="#C9CCF6" />
  </Style>

  <Style Selector="Border.cardIcon">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Path.cardIcon">
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="TextBlock.cardName">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.15" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.cardBlurb">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- panels of the tool screen -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="LetterSpacing" Value="1.1" />
  </Style>

  <Style Selector="Border.dropzone">
    <Setter Property="Background" Value="{StaticResource Canvas}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22" />
  </Style>

  <Style Selector="TextBlock.dropTitle">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.dropHint">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="TextBlock.link">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,11" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#4338CA" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#C7C9F5" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="TextBlock.optionLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style Selector="ComboBox.field">
    <Setter Property="Height" Value="38" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox.field">
    <Setter Property="Height" Value="38" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <Style Selector="CheckBox.field">
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <Style Selector="TextBlock.fileName">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.fileSize">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="TextBlock.resultName">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.notice">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

</Styles>
